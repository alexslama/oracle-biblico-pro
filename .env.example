# SHAMIR local configuration

# Web server
SHAMIR_HOST=127.0.0.1
SHAMIR_PORT=5000
SHAMIR_MAX_QUERY_LENGTH=4000
FLASK_DEBUG=0

# Retrieval-Augmented Generation
SHAMIR_ENABLE_RAG=0
SHAMIR_VECTOR_DB=data/vector_db
SHAMIR_COLLECTION=shamir_sources
SHAMIR_EMBEDDING_MODEL=nomic-embed-text
SHAMIR_TOP_K=5

# Local LLM generation
SHAMIR_ENABLE_LLM=0
SHAMIR_LLM_MODEL=llama3.1
